rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email.matches('(?i).*santosh.*@gmail\\.com') ||
        request.auth.token.email == 'santoshghartimagar918@gmail.com' ||
        request.auth.token.email == 'santoshghartimagar@gmail.com' ||
        request.auth.token.email == 'santosh11318@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for BlogPost
    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'slug', 'category', 'excerpt', 'content', 'authorId', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'slug', 'category', 'excerpt', 'content', 'coverImage', 'authorName', 'authorEmail', 'authorId', 'tags', 'readTime', 'status', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
        data.slug is string && data.slug.size() >= 3 && data.slug.size() <= 160 &&
        data.category in ['AI & Tech', 'Web Development', 'SEO & Marketing', 'Business & Growth', 'Tutorials'] &&
        data.excerpt is string && data.excerpt.size() >= 10 && data.excerpt.size() <= 300 &&
        data.content is string && data.content.size() >= 20 && data.content.size() <= 50000 &&
        data.authorId is string && data.authorId == request.auth.uid &&
        data.status in ['draft', 'published'] &&
        (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 1000)) &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 120)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
        (!('readTime' in data) || (data.readTime is string && data.readTime.size() <= 30)) &&
        data.createdAt is string &&
        data.updatedAt is string;
    }

    // Validation Blueprint for Inquiries
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'phone', 'createdAt', 'status']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
        data.createdAt is string &&
        data.status in ['new', 'contacted', 'closed'];
    }

    // Validation Blueprint for Visitor Analytics
    function isValidAnalyticsVisit(data) {
      return data.keys().hasAll(['timestamp', 'path', 'device', 'referrer']) &&
        data.timestamp is string &&
        data.path is string && data.path.size() <= 200 &&
        data.device is string && data.device.size() <= 50 &&
        data.referrer is string && data.referrer.size() <= 200;
    }

    // Posts Collection Rules
    match /posts/{postId} {
      allow get: if isValidId(postId) && (
        resource.data.status == 'published' || isAdmin()
      );

      allow list: if (
        resource.data.status == 'published' || isAdmin()
      );

      allow create: if isValidId(postId) && isAdmin() &&
        isValidBlogPost(incoming()) &&
        incoming().authorId == request.auth.uid;

      allow update: if isValidId(postId) && isAdmin() &&
        isValidBlogPost(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().authorId == existing().authorId;

      allow delete: if isValidId(postId) && isAdmin();
    }

    // Client Inquiries Collection Rules
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // Projects Collection Rules
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Site Settings Collection Rules (Pricing, Counters, Contact Info)
    match /site_settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Visitor Analytics Collection Rules
    match /analytics_visits/{visitId} {
      allow create: if isValidId(visitId) && isValidAnalyticsVisit(incoming());
      allow get, list, delete: if isAdmin();
    }

    // Admins Collection Rules
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (
        request.auth.uid == adminId || isAdmin()
      );
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) && isSignedIn() && (
        isAdmin() || (request.auth.uid == adminId && request.resource.data.pin == 'santosh918')
      );
      allow delete: if isAdmin();
    }
  }
}
